{
  "name": "imontour-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:api": "vitest run test/api",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "token": "node --env-file-if-exists=.env --import tsx scripts/token.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "migrate": "tsx scripts/migrate.ts",
    "local": "npm run db:up && npm run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:browse": "tsx scripts/db-browse.ts",
    "db:browse:stop": "docker compose --profile tools stop adminer"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
