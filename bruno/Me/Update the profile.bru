meta {
  name: Update the profile
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/v1/me
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "displayName": "Test User",
    "locale": "en-GB"
  }
}

docs {
  Update the profile

  Changes `displayName` and/or `locale`. Absent fields are unchanged; `null` clears a field.
}
