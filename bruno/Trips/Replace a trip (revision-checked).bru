meta {
  name: Replace a trip (revision-checked)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/trips/{{tripId}}
  body: json
  auth: inherit
}

headers {
  If-Match: {{etag}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "schemaVersion": 1,
    "name": "Japan and Portugal (revised)",
    "destinations": [
      {
        "id": "3f1c2b8e-6a47-4d0e-9f5b-1c2d3e4f5a61",
        "rawInput": "tokyo 5 days",
        "color": "coral",
        "place": {
          "displayName": "Tokyo",
          "type": "city",
          "latitude": 35.68,
          "longitude": 139.69,
          "countryCode": "JP"
        },
        "timing": {
          "mode": "explicitDates",
          "startDay": "2027-04-01",
          "endDay": "2027-04-05",
          "durationDays": 5,
          "isPlaceholder": false
        }
      },
      {
        "id": "7a9d4c10-2b3e-4f65-8a71-9b0c1d2e3f42",
        "rawInput": "lisbon 4 days",
        "color": "teal",
        "place": {
          "displayName": "Lisbon",
          "type": "city",
          "latitude": 38.72,
          "longitude": -9.14,
          "countryCode": "PT"
        },
        "timing": {
          "mode": "fuzzyMonth",
          "targetYear": 2027,
          "targetMonth": 5,
          "isPlaceholder": false
        }
      }
    ]
  }
}

script:post-response {
  // Keeps {{tripId}} and {{etag}} up to date for the next request.
  if (res.getStatus() < 300) {
    bru.setVar("tripId", res.getBody().id);
    bru.setVar("etag", res.getHeader("etag"));
  }
}

docs {
  Replace a trip (revision-checked)

  Replaces the whole trip document. The `If-Match` header is required; a missing one yields 428. A stale revision yields 412 with `currentRevision`.
}
