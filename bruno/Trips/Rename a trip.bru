meta {
  name: Rename a trip
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/v1/trips/{{tripId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "Japan and Portugal, renamed"
  }
}

script:post-response {
  // Keeps {{tripId}} and {{etag}} up to date for the next request.
  if (res.getStatus() < 300) {
    bru.setVar("tripId", res.getBody().id);
    bru.setVar("etag", res.getHeader("etag"));
  }
}

docs {
  Rename a trip

  Changes only the name, unconditionally (last write wins), and bumps the revision. Use `PUT` with `If-Match` for a change that must not overwrite a newer revision.
}
