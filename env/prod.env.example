# imontour-api: production environment (its own Supabase project).
# Real values live in Vercel/Supabase environment settings, never in git.
# Copy to .env only for local development.

# Runtime environment: local | dev | staging | prod.
APP_ENV=prod
# HTTP port (ignored on Vercel).
PORT=3000
# The production Supabase project's pooled (transaction pooler, port 6543) connection string. Secret.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres
# Schema holding the app tables.
DB_SCHEMA=public
# Expected token issuer (Supabase Auth).
AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Expected token audience.
AUTH_AUDIENCE=authenticated
# Public signing keys used to verify tokens. Set this OR AUTH_JWT_SECRET, never both.
AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 shared secret (alternative to AUTH_JWKS_URL). Secret.
# AUTH_JWT_SECRET=<jwt-secret>
# Optional: lets DELETE /v1/me also delete the Supabase auth user. Set both or neither (without them the
# provider account is left in place). The key is a secret with full admin rights: use a new `sb_secret_...` API key (or the legacy service_role key).
# AUTH_ADMIN_URL=https://<project-ref>.supabase.co
# AUTH_ADMIN_SERVICE_KEY=<secret-api-key>
# Optional: lets DELETE /v1/me revoke the user's Sign in with Apple token (App Store requirement for apps with Sign in with Apple).
# Set all four or none. The key is the .p8 from Apple Developer > Keys (Sign in with Apple enabled); newlines may be written as \n. Secret.
# APPLE_TEAM_ID=<team-id>
# APPLE_KEY_ID=<key-id>
# APPLE_PRIVATE_KEY=<p8-contents>
# APPLE_CLIENT_ID=<app-bundle-id>
# Optional: turns on the operator-only POST /v1/admin/export (answers data-access requests by email). At least 32 characters,
# e.g. `openssl rand -hex 32`. Secret. Leave unset to keep the route off entirely.
# ADMIN_API_KEY=<random-secret>
# Remote config document served at GET /v1/config (bundled via vercel.json).
CONFIG_FILE=config/remote-config.json

# Local database browser only (npm run db:browse). Never set on Vercel. REQUIRED for prod browsing.
# Connection string of a READ-ONLY role, preferably via the session pooler (5432).
# BROWSE_DATABASE_URL=postgres://<readonly-role>.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres
