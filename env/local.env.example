# imontour-api: local development (docker-compose Postgres, self-signed local tokens).
# Real values live in Vercel/Supabase environment settings, never in git.
# Copy to .env only for local development.

# Runtime environment: local | dev | staging | prod.
APP_ENV=local
# HTTP port for the local server.
PORT=3000
# Postgres from docker-compose (npm run db:up).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/imontour
# Schema holding the app tables; migrations create it if missing.
DB_SCHEMA=public
# Expected token issuer; must match what `npm run token` signs.
AUTH_ISSUER=http://localhost:3000/local-auth
# Expected token audience.
AUTH_AUDIENCE=authenticated
# Local-only ES256 key pair, created on first start. Never allowed outside APP_ENV=local.
AUTH_LOCAL_KEY_FILE=.local/jwks.json
# Remote config document served at GET /v1/config.
CONFIG_FILE=config/remote-config.json
