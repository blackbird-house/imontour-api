# imontour-api: dev environment (the staging Supabase project, schema 'dev').
# Real values live in Vercel/Supabase environment settings, never in git.
# Copy to .env only for local development.

# Runtime environment: local | dev | staging | prod.
APP_ENV=dev
# HTTP port (ignored on Vercel).
PORT=3000
# The staging Supabase project's pooled (transaction pooler, port 6543) connection string. Secret.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres
# Schema holding the app tables.
DB_SCHEMA=dev
# Expected token issuer (Supabase Auth).
AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Expected token audience.
AUTH_AUDIENCE=authenticated
# Public signing keys used to verify tokens. Set this OR AUTH_JWT_SECRET, never both.
AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 shared secret (alternative to AUTH_JWKS_URL). Secret.
# AUTH_JWT_SECRET=<jwt-secret>
# Remote config document served at GET /v1/config (bundled via vercel.json).
CONFIG_FILE=config/remote-config.json
